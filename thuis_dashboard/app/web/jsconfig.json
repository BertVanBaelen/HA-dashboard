{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": true,
    "allowJs": true,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["svelte"],
    "paths": { "$shared/*": ["../shared/*"] }
  },
  "include": ["src/**/*", "../shared/**/*"]
}
